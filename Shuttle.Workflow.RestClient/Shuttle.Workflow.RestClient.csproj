<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	  <PackageReference Include="Refit" Version="15.2.0" />
	  <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Shuttle.Workflow.WebApi.Contracts\Shuttle.Workflow.WebApi.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>
	
	<PropertyGroup>
		<Authors>Eben Roux</Authors>
		<Company>Shuttle</Company>
		<Description>A client for interacting with a Shuttle.Workflow.WebApi endpoint.</Description>
		<Copyright>Copyright (c) 2026, Eben Roux</Copyright>
		<PackageProjectUrl>https://github.com/Shuttle/Shuttle.Workflow</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Shuttle/Shuttle.Workflow.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>workflow rest client</PackageTags>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<Version>3.1.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<Target Name="CopyNuGetPackage" AfterTargets="Pack" Condition="'$(NUGET_PACKAGE_FOLDER)' != ''">
		<Message Text="Removing cached NuGet package '$(USERPROFILE)\.nuget\packages\$(AssemblyName)\$(Version)'..." Importance="high" />
		<RemoveDir Directories="$(USERPROFILE)\.nuget\packages\$(AssemblyName)\$(Version)" />
		<Message Text="Copying NuGet package to '$(NUGET_PACKAGE_FOLDER)'..." Importance="high" />
		<Copy SourceFiles="bin\$(Configuration)\$(AssemblyName).$(Version).nupkg" DestinationFolder="$(NUGET_PACKAGE_FOLDER)" SkipUnchangedFiles="true" />
	</Target>

</Project>