{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "azure": "UseDevelopmentStorage=true;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 1048576,
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Shuttle": {
    "Workflow": {
      "SqlServer": {
        "Semaphores": [
          {
            "KeyRegex": "^\\[(warehouse|register-warehouse)",
            "MinimumLifetime": "00:00:05",
            "Lifetime": "00:30:00",
            "RemoveWhenExpired": true
          }
        ]
      }
    },
    "Hopper": {
      "Inbox": {
        "WorkTransportUri": "azuresq://azure/workflow-server-work",
        "DeferredTransportUri": "azuresq://azure/workflow-server-deferred",
        "ErrorTransportUri": "azuresq://azure/workflow-server-error",
        "ThreadCount": 1
      },
      "MessageRoutes": [
        {
          "Uri": "azuresq://azure/workflow-server-work",
          "Specifications": [
            {
              "Name": "StartsWith",
              "Value": "Shuttle.Workflow.Messages"
            }
          ]
        }
      ]
    }
  }
}